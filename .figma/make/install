#!/usr/bin/env bash
set -euo pipefail

if [[ -f "package.json" ]]; then
  if [[ -f "pnpm-lock.yaml" ]]; then
    exec pnpm install --frozen-lockfile
  elif [[ -f "package-lock.json" ]]; then
    exec npm ci
  elif [[ -f "yarn.lock" ]]; then
    exec yarn install --frozen-lockfile
  else
    exec pnpm install
  fi
fi

RUNTIME_DIR="/tmp/figma-make-runtime"
mkdir -p "$RUNTIME_DIR"

cat > "$RUNTIME_DIR/package.json" <<'EOF'
{
  "name": "figma-make-runtime",
  "private": true,
  "type": "module",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.2.0"
  }
}
EOF

cat > "$RUNTIME_DIR/index.html" <<'EOF'
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IconWrapper Preview</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <div id="root"></div>
    <script type="module" src="/main.jsx"></script>
  </body>
</html>
EOF

cat > "$RUNTIME_DIR/main.jsx" <<'EOF'
import React from 'react';
import { createRoot } from 'react-dom/client';
import { HeroIcon } from '@iconwrapper';

function App() {
  return (
    <main className="min-h-screen flex items-center justify-center p-6">
      <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-8 max-w-md w-full space-y-6">
        <div>
          <h1 className="text-lg font-semibold text-gray-900">HeroIcon Component</h1>
          <p className="text-sm text-gray-500 mt-1">Previewing Iconwrapper component variants</p>
        </div>
        <div className="grid grid-cols-3 gap-4">
          <div className="flex flex-col items-center gap-2 p-4 rounded-lg bg-gray-50 border border-gray-100">
            <HeroIcon name="beaker" className="h-8 w-8 text-indigo-600" />
            <span className="text-xs font-medium text-gray-600">beaker</span>
          </div>
          <div className="flex flex-col items-center gap-2 p-4 rounded-lg bg-gray-50 border border-gray-100">
            <HeroIcon name="heart" className="h-8 w-8 text-rose-500" />
            <span className="text-xs font-medium text-gray-600">heart</span>
          </div>
          <div className="flex flex-col items-center gap-2 p-4 rounded-lg bg-gray-50 border border-gray-100">
            <HeroIcon name="default" />
            <span className="text-xs font-medium text-gray-600">default</span>
          </div>
        </div>
      </div>
    </main>
  );
}

createRoot(document.getElementById('root')).render(<App />);
EOF

cd "$RUNTIME_DIR"
exec pnpm install --prefer-offline
